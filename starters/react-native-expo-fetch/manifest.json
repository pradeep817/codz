{
  "schema": 1,
  "id": "react-native-expo-fetch",
  "version": "1.0.0",
  "title": "React Native (Expo) with a typed fetch helper",
  "summary": "Expo with React Navigation, apiFetch<T>() with timeouts and readable errors, a useApi() hook for loading, error and pull to refresh, and themes that follow the phone.",
  "framework": "react-native",
  "mode": "full",
  "requires": {
    "devtool": ">=0.1.0",
    "node": ">=18.18"
  },
  "provides": {
    "flavor": "expo",
    "router": "react-navigation",
    "http": "fetch"
  },
  "extras": [
    "useApi() hook with loading, error and refresh state",
    "Loading and error views with a retry button",
    "Light and dark themes that follow the phone",
    "Request timeouts and user-facing error messages",
    "A Jest test and a typecheck script"
  ],
  "apiAdd": {
    "supported": true
  },
  "answers": [
    {
      "key": "appName",
      "prompt": "Package name",
      "type": "npm-name",
      "default": "my-app"
    },
    {
      "key": "appTitle",
      "prompt": "App title",
      "type": "string",
      "default": "My App",
      "maxLength": 60
    },
    {
      "key": "bundleId",
      "prompt": "App id (iOS bundle id and Android package)",
      "type": "reverse-domain",
      "default": "com.example.myapp"
    },
    {
      "key": "apiBaseUrl",
      "prompt": "API base URL",
      "type": "string",
      "default": "https://api.example.com",
      "maxLength": 200
    }
  ],
  "dependencies": {
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~52.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "steps": [
    "npm_install"
  ],
  "expectedConventions": {
    "http": "fetch",
    "httpHelper": "apiFetch",
    "httpHelperFile": "src/api/client.ts",
    "apiFolder": "src/api",
    "importAlias": "@/",
    "flavor": "expo",
    "router": "react-navigation",
    "navigatorFile": "src/navigation/RootNavigator.tsx",
    "screensFolder": "src/screens"
  },
