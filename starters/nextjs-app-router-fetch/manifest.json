{
  "schema": 1,
  "id": "nextjs-app-router-fetch",
  "version": "1.0.0",
  "title": "Next.js App Router with a typed fetch helper",
  "summary": "Next.js with the App Router, strict TypeScript, apiFetch<T>() with ApiError, error and not-found pages, and light/dark CSS variables.",
  "framework": "nextjs",
  "mode": "full",
  "requires": {
    "codz": ">=0.1.0",
    "node": ">=18.18"
  },
  "provides": {
    "router": "app-router",
    "http": "fetch"
  },
  "extras": [
    "Error and not-found pages",
    "Light and dark CSS variables",
    "A typecheck script",
    ".env.example for the API address"
  ],
  "apiAdd": {
    "supported": true
  },
  "answers": [
    {
      "key": "appName",
      "prompt": "Package name",
      "type": "npm-name",
      "default": "my-app"
    },
    {
      "key": "appTitle",
      "prompt": "App title",
      "type": "string",
      "default": "My App",
      "maxLength": 60
    },
    {
      "key": "apiBaseUrl",
      "prompt": "API base URL",
      "type": "string",
      "default": "https://api.example.com",
      "maxLength": 200
    }
  ],
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "steps": [
    "npm_install"
  ],
  "expectedConventions": {
    "http": "fetch",
    "httpHelper": "apiFetch",
    "httpHelperFile": "lib/api/client.ts",
    "apiFolder": "lib/api",
    "baseUrlEnv": "NEXT_PUBLIC_API_URL",
    "importAlias": "@/"
  },
