{
  "schema": 1,
  "id": "android-compose-hilt",
  "version": "1.0.0",
  "title": "Android with Compose, Hilt and Retrofit",
  "summary": "Kotlin and Jetpack Compose with Material 3, Navigation Compose, Hilt and Retrofit with kotlinx.serialization, plus safeApiCall() with readable errors and ready-made loading and error views.",
  "framework": "android",
  "mode": "full",
  "requires": {
    "devtool": ">=0.1.0"
  },
  "provides": {
    "ui": "compose",
    "di": "hilt",
    "http": "retrofit",
    "serialization": "kotlinx"
  },
  "extras": [
    "safeApiCall() with ApiResult and user-facing messages",
    "UiState, LoadingView and ErrorView for every screen",
    "Material 3 themes with optional dynamic color",
    "HTTP logging in debug builds only, with timeouts",
    "A JUnit test and the Gradle wrapper"
  ],
  "apiAdd": {
    "supported": true
  },
  "answers": [
    {
      "key": "appName",
      "prompt": "Folder name",
      "type": "npm-name",
      "default": "my-app"
    },
    {
      "key": "appTitle",
      "prompt": "App title",
      "type": "string",
      "default": "My App",
      "maxLength": 60
    },
    {
      "key": "packageName",
      "prompt": "Package (application id)",
      "type": "reverse-domain",
      "default": "com.example.myapp"
    },
    {
      "key": "apiBaseUrl",
      "prompt": "API base URL (without a trailing /)",
      "type": "string",
      "default": "https://api.example.com",
      "maxLength": 200
    }
  ],
  "dependencies": {},
  "steps": [],
  "expectedConventions": {
    "module": "app",
    "versionCatalog": "gradle/libs.versions.toml",
    "srcDir": "app/src/main/java",
    "http": "retrofit",
    "serialization": "kotlinx",
    "di": "hilt",
    "ui": "compose"
  },
