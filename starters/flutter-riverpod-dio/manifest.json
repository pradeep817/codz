{
  "schema": 1,
  "id": "flutter-riverpod-dio",
  "version": "1.0.0",
  "title": "Flutter with Riverpod, Dio and go_router",
  "summary": "A Flutter app with Riverpod for state and DI, Dio for HTTP, go_router for navigation, light and dark themes and readable API error messages.",
  "framework": "flutter",
  "mode": "overlay",
  "requires": {
    "devtool": ">=0.1.0",
    "flutter": ">=3.24"
  },
  "provides": {
    "state": "riverpod",
    "router": "go_router",
    "http": "dio",
    "serialization": "manual"
  },
  "extras": [
    "go_router with a not-found page",
    "Light and dark Material 3 themes",
    "API base URL per build with --dart-define",
    "User-facing messages for network errors",
    "A widget test that runs"
  ],
  "apiAdd": {
    "supported": true
  },
  "answers": [
    {
      "key": "appName",
      "prompt": "Package name",
      "type": "identifier",
      "default": "my_app"
    },
    {
      "key": "org",
      "prompt": "Organization id",
      "type": "reverse-domain",
      "default": "com.example"
    },
    {
      "key": "appTitle",
      "prompt": "App title",
      "type": "string",
      "default": "My App",
      "maxLength": 60
    },
    {
      "key": "apiBaseUrl",
      "prompt": "API base URL",
      "type": "string",
      "default": "https://api.example.com",
      "maxLength": 200
    }
  ],
  "dependencies": {
    "dio": "^5.7.0",
    "flutter_riverpod": "^2.6.1",
    "go_router": "^14.6.2"
  },
  "steps": [
    "flutter_create",
    "flutter_pub_get",
    "dart_format"
  ],
  "expectedConventions": {
    "http": "dio",
    "di": "riverpod",
    "stateManagement": "riverpod",
    "modelsFolder": "lib/data/models",
    "networkFile": "lib/core/network/dio_provider.dart"
  },
