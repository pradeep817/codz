{
  "schema": 1,
  "id": "flutter-bloc-auth-pro",
  "version": "1.0.0",
  "title": "Flutter app with sign-in, bloc and token refresh",
  "summary": "A Flutter app with sign-in through your API: flutter_bloc, Dio that sends the token and refreshes it on a 401, secure token storage, go_router that guards signed-in pages, bottom navigation and a settings page.",
  "framework": "flutter",
  "mode": "overlay",
  "requires": {
    "codz": ">=0.1.0",
    "flutter": ">=3.24"
  },
  "provides": {
    "state": "bloc",
    "router": "go_router",
    "http": "dio",
    "di": "get_it",
    "serialization": "manual",
    "auth": "secure-storage"
  },
  "extras": [
    "Login page with validation and readable errors",
    "Token refresh on 401 with a queued Dio interceptor",
    "Tokens in the Keychain or Keystore",
    "go_router redirects between sign-in and the app",
    "Bottom navigation and a settings page",
    "Light, dark or system theme, remembered",
    "A widget test for the login flow"
  ],
  "apiAdd": {
    "supported": true
  },
  "answers": [
    {
      "key": "appName",
      "prompt": "Package name",
      "type": "identifier",
      "default": "my_app"
    },
    {
      "key": "org",
      "prompt": "Organization id",
      "type": "reverse-domain",
      "default": "com.example"
    },
    {
      "key": "appTitle",
      "prompt": "App title",
      "type": "string",
      "default": "My App",
      "maxLength": 60
    },
    {
      "key": "apiBaseUrl",
      "prompt": "API base URL",
      "type": "string",
      "default": "https://api.example.com",
      "maxLength": 200
    }
  ],
  "dependencies": {
    "dio": "^5.7.0",
    "flutter_bloc": "^8.1.6",
    "flutter_secure_storage": "^9.2.2",
    "get_it": "^8.0.2",
    "go_router": "^14.6.2",
    "shared_preferences": "^2.3.3"
  },
  "steps": [
    "flutter_create",
    "flutter_pub_get",
    "dart_format"
  ],
  "expectedConventions": {
    "http": "dio",
    "stateManagement": "bloc",
    "di": "get_it",
    "modelsFolder": "lib/data/models",
    "repoFolder": "lib/data/repositories",
    "networkFile": "lib/core/network/api_client.dart",
    "diFile": "lib/core/di/injection.dart"
  },
