{
  "schema": 1,
  "id": "nextjs-saas-pro",
  "version": "1.0.0",
  "title": "Next.js SaaS dashboard with sign-in",
  "summary": "A Next.js App Router dashboard with sign-in through your API: server actions, the token in an HttpOnly cookie, protected pages, a sidebar layout, a profile page, and loading and error states.",
  "framework": "nextjs",
  "mode": "full",
  "requires": {
    "devtool": ">=0.1.0",
    "node": ">=18.18"
  },
  "provides": {
    "router": "app-router",
    "http": "fetch",
    "auth": "cookie-session"
  },
  "extras": [
    "Sign-in with server actions and an HttpOnly session cookie",
    "Middleware that protects private pages",
    "Sidebar dashboard layout that works on phones",
    "Profile settings with save and error states",
    "apiFetch() that sends the signed-in user's token",
    "Loading, error and not-found pages"
  ],
  "apiAdd": {
    "supported": true
  },
  "answers": [
    {
      "key": "appName",
      "prompt": "Package name",
      "type": "npm-name",
      "default": "my-app"
    },
    {
      "key": "appTitle",
      "prompt": "App title",
      "type": "string",
      "default": "My App",
      "maxLength": 60
    },
    {
      "key": "apiBaseUrl",
      "prompt": "API base URL",
      "type": "string",
      "default": "https://api.example.com",
      "maxLength": 200
    }
  ],
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "steps": [
    "npm_install"
  ],
  "expectedConventions": {
    "http": "fetch",
    "httpHelper": "apiFetch",
    "httpHelperFile": "lib/api/client.ts",
    "apiFolder": "lib/api",
    "baseUrlEnv": "API_URL",
    "importAlias": "@/"
  },
