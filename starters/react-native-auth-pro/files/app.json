{
  "expo": {
    "name": "{{appTitle}}",
    "slug": "{{appName}}",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "{{bundleId}}"
    },
    "android": {
      "package": "{{bundleId}}"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
