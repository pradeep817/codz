{
  "schema": 1,
  "id": "react-native-auth-pro",
  "version": "1.0.0",
  "title": "React Native (Expo) app with sign-in and tabs",
  "summary": "Expo with sign-in through your API: the token in secure storage, axios that sends it and signs out on 401, React Query with sensible retries, a login screen, bottom tabs and a profile screen.",
  "framework": "react-native",
  "mode": "full",
  "requires": {
    "codz": ">=0.1.0",
    "node": ">=18.18"
  },
  "provides": {
    "flavor": "expo",
    "router": "react-navigation",
    "http": "axios",
    "data": "react-query",
    "auth": "secure-store"
  },
  "extras": [
    "Login screen with validation and error messages",
    "Token in the Keychain or Keystore with expo-secure-store",
    "Signs out on any 401, restores the session at launch",
    "React Query with retries only where they help",
    "Bottom tabs and a profile screen with sign out",
    "Reusable Button and TextField components"
  ],
  "apiAdd": {
    "supported": true
  },
  "answers": [
    {
      "key": "appName",
      "prompt": "Package name",
      "type": "npm-name",
      "default": "my-app"
    },
    {
      "key": "appTitle",
      "prompt": "App title",
      "type": "string",
      "default": "My App",
      "maxLength": 60
    },
    {
      "key": "bundleId",
      "prompt": "App id (iOS bundle id and Android package)",
      "type": "reverse-domain",
      "default": "com.example.myapp"
    },
    {
      "key": "apiBaseUrl",
      "prompt": "API base URL",
      "type": "string",
      "default": "https://api.example.com",
      "maxLength": 200
    }
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "expo": "~52.0.0",
    "expo-secure-store": "~14.0.0",
    "react-native": "0.76.5"
  },
  "steps": [
    "npm_install"
  ],
  "expectedConventions": {
    "http": "axios",
    "apiFolder": "src/api",
    "axiosInstance": "api",
    "axiosInstanceFile": "src/api/client.ts",
    "dataFetching": "react-query",
    "hooksFolder": "src/hooks",
    "modelsFolder": "src/types",
    "flavor": "expo",
    "router": "react-navigation",
    "navigatorFile": "src/navigation/RootNavigator.tsx",
    "screensFolder": "src/screens"
  },
