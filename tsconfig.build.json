{
  // Compiles src/ to dist/ for the npm package, so it runs on Node 20+
  // (Node 22.18+ can run src/ directly). npm run build
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "declaration": false,
    "removeComments": false
  },
  "include": ["src"],
  "exclude": []
}
