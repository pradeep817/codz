{
  "name": "codz-cli",
  "version": "0.1.6",
  "description": "CLI that adds API models, screens, routes and tests to Flutter, Next.js, React Native, Android and iOS apps in your project's own style, from OpenAPI or cURL.",
  "type": "module",
  "bin": {
    "codz": "bin/codz.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "docs/COMMANDS.md",
    "examples",
    "assets",
    "BETA.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "test:update-golden": "UPDATE_GOLDEN=1 node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "docs": "node scripts/gen-docs.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "beta:pack": "bash scripts/beta-pack.sh",
    "check:all": "bash scripts/check-all.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "codz-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pradeep817/codz.git"
  },
  "homepage": "https://github.com/pradeep817/codz#readme",
  "bugs": {
    "url": "https://github.com/pradeep817/codz/issues"
  },
  "keywords": [
    "cli",
    "codegen",
    "openapi",
    "flutter",
    "nextjs",
    "react-native",
    "react",
    "android",
    "ios",
    "swiftui"
  ]
}
