{
  "name": "devtool-vscode",
  "displayName": "devtool",
  "description": "Add endpoints, sync with an API spec, generate mocks and tests, and check your Next.js or Flutter project, with every change previewed as a diff.",
  "version": "0.1.0",
  "publisher": "pradeeppandey",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Linters"],
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:devtool.config.yaml", "workspaceContains:pubspec.yaml", "workspaceContains:next.config.*"],
  "contributes": {
    "commands": [
      { "command": "devtool.addEndpoint", "title": "Add endpoint (cURL or URL)", "category": "devtool" },
      { "command": "devtool.syncSpec", "title": "Sync with API spec", "category": "devtool" },
      { "command": "devtool.showEndpoint", "title": "Show endpoint and its uses", "category": "devtool" },
      { "command": "devtool.renameEndpoint", "title": "Rename endpoint", "category": "devtool" },
      { "command": "devtool.mockAll", "title": "Mock every endpoint", "category": "devtool" },
      { "command": "devtool.testAll", "title": "Write tests for every endpoint", "category": "devtool" },
      { "command": "devtool.doctor", "title": "Doctor (show findings in Problems)", "category": "devtool" },
      { "command": "devtool.doctorFix", "title": "Doctor: fix what is safe", "category": "devtool" },
      { "command": "devtool.explain", "title": "Explain project", "category": "devtool" },
      { "command": "devtool.undo", "title": "Undo last change", "category": "devtool" }
    ],
    "configuration": {
      "title": "devtool",
      "properties": {
        "devtool.path": { "type": "string", "default": "devtool", "description": "The devtool command (a full path if it is not on PATH)." }
      }
    }
  }
}
